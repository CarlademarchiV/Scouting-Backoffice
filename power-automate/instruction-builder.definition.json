{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "description": "InstructionBuilder (componente reutilizable). Recibe un Trabajo en trabajoJson y arma la instrucción en dos capas: 1) capa del origen: prompt + plantilla + variables; 2) capa institucional: el perfil (de la variable de entorno de la solución ucu_InstruccionesInstitucionales) envuelve la instrucción con su plantilla ({{instruccion}}) y suma sus políticas a las del origen. Luego llama al agente (si no hay resultadoPrevio), separa el resumen y pide el envío a Comunicaciones. Siempre responde resultadoJson.",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "ucu_InstruccionesInstitucionales (ucu_InstruccionesInstitucionales)": {
      "defaultValue": {},
      "type": "Object",
      "metadata": {
        "schemaName": "ucu_InstruccionesInstitucionales",
        "description": "Variable de entorno (JSON) con los perfiles institucionales. Ejemplo en power-automate/config/instrucciones-institucionales.example.json"
      }
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "description": "Flujo hijo",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "trabajoJson": {
              "type": "string",
              "title": "trabajoJson",
              "x-ms-dynamically-added": true,
              "description": "Trabajo según contratos/trabajo.schema.json"
            }
          },
          "required": [
            "trabajoJson"
          ]
        }
      }
    }
  },
  "actions": {
    "Inicializar": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "trabajo",
            "type": "object",
            "value": "@json(triggerBody()?['text'])"
          },
          {
            "name": "instruccion",
            "type": "string",
            "value": ""
          },
          {
            "name": "respuesta",
            "type": "string",
            "value": "@{coalesce(json(triggerBody()?['text'])?['resultadoPrevio'],'')}"
          },
          {
            "name": "etapa",
            "type": "string",
            "value": "instruccion"
          },
          {
            "name": "error",
            "type": "string",
            "value": ""
          },
          {
            "name": "destinatarios",
            "type": "integer",
            "value": 0
          }
        ]
      },
      "runAfter": {}
    },
    "Try": {
      "type": "Scope",
      "runAfter": {
        "Inicializar": [
          "Succeeded"
        ]
      },
      "actions": {
        "Base": {
          "type": "SetVariable",
          "description": "Sin plantilla: el prompt tal cual. Con plantilla: reemplaza {{prompt}}.",
          "inputs": {
            "name": "instruccion",
            "value": "@if(empty(coalesce(variables('trabajo')?['instruccion']?['plantilla'],'')),variables('trabajo')?['instruccion']?['prompt'],replace(variables('trabajo')?['instruccion']?['plantilla'],'{{prompt}}',variables('trabajo')?['instruccion']?['prompt']))"
          },
          "runAfter": {}
        },
        "Perfil": {
          "type": "Compose",
          "description": "Perfil institucional elegido (o el por defecto). Si no existe, falla en etapa 'instruccion'.",
          "inputs": "@parameters('ucu_InstruccionesInstitucionales (ucu_InstruccionesInstitucionales)')?['perfiles']?[coalesce(variables('trabajo')?['instruccion']?['perfil'],parameters('ucu_InstruccionesInstitucionales (ucu_InstruccionesInstitucionales)')?['perfilPorDefecto'],'sin-reglas')]",
          "runAfter": {
            "Base": [
              "Succeeded"
            ]
          }
        },
        "Perfil_valido": {
          "type": "If",
          "expression": {
            "equals": [
              "@empty(outputs('Perfil'))",
              true
            ]
          },
          "runAfter": {
            "Perfil": [
              "Succeeded"
            ]
          },
          "actions": {
            "Error_perfil": {
              "type": "SetVariable",
              "inputs": {
                "name": "error",
                "value": "@{concat('Perfil institucional inexistente: ',coalesce(variables('trabajo')?['instruccion']?['perfil'],''))}"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Instruccion_origen": {
                "type": "Compose",
                "inputs": "@variables('instruccion')",
                "runAfter": {}
              },
              "Capa_institucional": {
                "type": "SetVariable",
                "description": "Envuelve la instrucción del origen con la plantilla del perfil institucional ({{instruccion}}).",
                "inputs": {
                  "name": "instruccion",
                  "value": "@replace(coalesce(outputs('Perfil')?['plantilla'],'{{instruccion}}'),'{{instruccion}}',outputs('Instruccion_origen'))"
                },
                "runAfter": {
                  "Instruccion_origen": [
                    "Succeeded"
                  ]
                }
              },
              "Reemplazar_variables": {
                "type": "Foreach",
                "foreach": "@coalesce(variables('trabajo')?['instruccion']?['variables'],createArray())",
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 1
                  }
                },
                "runAfter": {
                  "Capa_institucional": [
                    "Succeeded"
                  ]
                },
                "actions": {
                  "Valor_actual": {
                    "type": "Compose",
                    "inputs": "@variables('instruccion')",
                    "runAfter": {}
                  },
                  "Reemplazar": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "instruccion",
                      "value": "@replace(outputs('Valor_actual'),concat('{{',items('Reemplazar_variables')?['nombre'],'}}'),items('Reemplazar_variables')?['valor'])"
                    },
                    "runAfter": {
                      "Valor_actual": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "description": "Reemplaza {{nombre}} de cada variable en la instrucción completa (origen + institucional)."
              },
              "Politicas": {
                "type": "Compose",
                "description": "Políticas institucionales primero, luego las del origen.",
                "inputs": "@union(coalesce(outputs('Perfil')?['politicas'],createArray()),coalesce(variables('trabajo')?['instruccion']?['politicas'],createArray()))",
                "runAfter": {
                  "Reemplazar_variables": [
                    "Succeeded"
                  ]
                }
              },
              "Con_politicas": {
                "type": "Compose",
                "inputs": "@if(empty(outputs('Politicas')),variables('instruccion'),concat(variables('instruccion'),decodeUriComponent('%0A%0A'),'Reglas que tenés que respetar:',decodeUriComponent('%0A'),'- ',join(outputs('Politicas'),concat(decodeUriComponent('%0A'),'- '))))",
                "runAfter": {
                  "Politicas": [
                    "Succeeded"
                  ]
                }
              },
              "Etapa_agente": {
                "type": "SetVariable",
                "inputs": {
                  "name": "etapa",
                  "value": "agente"
                },
                "runAfter": {
                  "Con_politicas": [
                    "Succeeded"
                  ]
                }
              },
              "Falta_respuesta": {
                "type": "If",
                "expression": {
                  "equals": [
                    "@variables('respuesta')",
                    ""
                  ]
                },
                "runAfter": {
                  "Etapa_agente": [
                    "Succeeded"
                  ]
                },
                "actions": {
                  "Segun_agente": {
                    "type": "Switch",
                    "expression": "@variables('trabajo')?['agente']",
                    "runAfter": {},
                    "cases": {
                      "Scouting": {
                        "case": "Scouting",
                        "actions": {
                          "Agente_Scouting": {
                            "type": "OpenApiConnectionWebhook",
                            "description": "Copilot Studio: Ejecutar un agente y esperar (ucu_Scouting). Para sumar un agente, agregar un caso con su propia acción.",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_microsoftcopilotstudio",
                                "operationId": "ExecuteCopilotAsyncV2",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio"
                              },
                              "parameters": {
                                "Copilot": "ucu_Scouting",
                                "body/message": "@outputs('Con_politicas')"
                              },
                              "authentication": "@parameters('$authentication')"
                            },
                            "limit": {
                              "timeout": "PT20M"
                            },
                            "runAfter": {}
                          },
                          "Respuesta_Scouting": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "respuesta",
                              "value": "@{body('Agente_Scouting')?['lastResponse']}"
                            },
                            "runAfter": {
                              "Agente_Scouting": [
                                "Succeeded"
                              ]
                            }
                          }
                        }
                      }
                    },
                    "default": {
                      "actions": {
                        "Error_agente": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "error",
                            "value": "@{concat('Agente no soportado: ',variables('trabajo')?['agente'])}"
                          },
                          "runAfter": {}
                        }
                      }
                    }
                  }
                },
                "else": {
                  "actions": {}
                }
              },
              "Hay_respuesta": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@variables('error')",
                        ""
                      ]
                    },
                    {
                      "not": {
                        "equals": [
                          "@variables('respuesta')",
                          ""
                        ]
                      }
                    }
                  ]
                },
                "runAfter": {
                  "Falta_respuesta": [
                    "Succeeded"
                  ]
                },
                "actions": {
                  "Cuerpo": {
                    "type": "Compose",
                    "inputs": "@trim(first(split(variables('respuesta'),'===RESUMEN===')))",
                    "runAfter": {}
                  },
                  "Resumen": {
                    "type": "Compose",
                    "inputs": "@if(contains(variables('respuesta'),'===RESUMEN==='),trim(last(split(variables('respuesta'),'===RESUMEN==='))),'')",
                    "runAfter": {
                      "Cuerpo": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Etapa_comunicacion": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "etapa",
                      "value": "comunicacion"
                    },
                    "runAfter": {
                      "Resumen": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Comunicaciones": {
                    "type": "Workflow",
                    "inputs": {
                      "host": {
                        "workflowReferenceName": "<id del flujo Comunicaciones en la solución>"
                      },
                      "body": {
                        "text": "@{string(setProperty(variables('trabajo')?['comunicacion'],'contenido',setProperty(setProperty(coalesce(variables('trabajo')?['comunicacion']?['contenido'],json('{}')),'cuerpo',outputs('Cuerpo')),'resumen',outputs('Resumen'))))}"
                      }
                    },
                    "retryPolicy": {
                      "type": "fixed",
                      "count": 2,
                      "interval": "PT30S"
                    },
                    "runAfter": {
                      "Etapa_comunicacion": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Resultado_comunicacion": {
                    "type": "Compose",
                    "inputs": "@json(body('Comunicaciones')?['resultadojson'])",
                    "runAfter": {
                      "Comunicaciones": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Comunicacion_ok": {
                    "type": "If",
                    "expression": {
                      "equals": [
                        "@outputs('Resultado_comunicacion')?['ok']",
                        true
                      ]
                    },
                    "runAfter": {
                      "Resultado_comunicacion": [
                        "Succeeded"
                      ]
                    },
                    "actions": {
                      "Etapa_completo": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "etapa",
                          "value": "completo"
                        },
                        "runAfter": {}
                      },
                      "Destinatarios": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "destinatarios",
                          "value": "@outputs('Resultado_comunicacion')?['destinatarios']"
                        },
                        "runAfter": {
                          "Etapa_completo": [
                            "Succeeded"
                          ]
                        }
                      }
                    },
                    "else": {
                      "actions": {
                        "Error_comunicacion": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "error",
                            "value": "@{outputs('Resultado_comunicacion')?['error']}"
                          },
                          "runAfter": {}
                        }
                      }
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Sin_error_previo": {
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@variables('error')",
                          ""
                        ]
                      },
                      "runAfter": {},
                      "actions": {
                        "Error_sin_respuesta": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "error",
                            "value": "El agente no devolvió respuesta."
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Fallas": {
          "type": "Query",
          "inputs": {
            "from": "@result('Try')",
            "where": "@equals(item()?['status'],'Failed')"
          },
          "runAfter": {}
        },
        "Error": {
          "type": "SetVariable",
          "inputs": {
            "name": "error",
            "value": "@{string(coalesce(first(body('Fallas'))?['error']?['message'],first(body('Fallas'))?['outputs']?['body'],'Error sin detalle'))}"
          },
          "runAfter": {
            "Fallas": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "Resultado": {
      "type": "Compose",
      "runAfter": {
        "Catch": [
          "Succeeded",
          "Skipped",
          "Failed"
        ]
      },
      "inputs": {
        "id": "@{variables('trabajo')?['id']}",
        "ok": "@equals(variables('etapa'),'completo')",
        "etapa": "@variables('etapa')",
        "respuesta": "@variables('respuesta')",
        "resumen": "@if(contains(variables('respuesta'),'===RESUMEN==='),trim(last(split(variables('respuesta'),'===RESUMEN==='))),'')",
        "destinatarios": "@variables('destinatarios')",
        "error": "@variables('error')",
        "metadata": "@coalesce(variables('trabajo')?['metadata'],json('{}'))",
        "instruccionFinal": "@if(equals(variables('etapa'),'instruccion'),'',outputs('Con_politicas'))"
      }
    },
    "Responder": {
      "type": "Response",
      "kind": "PowerApp",
      "inputs": {
        "statusCode": 200,
        "body": {
          "resultadojson": "@{string(outputs('Resultado'))}"
        },
        "schema": {
          "type": "object",
          "properties": {
            "resultadojson": {
              "type": "string",
              "title": "resultadojson",
              "x-ms-dynamically-added": true
            }
          }
        }
      },
      "runAfter": {
        "Resultado": [
          "Succeeded"
        ]
      }
    }
  }
}
