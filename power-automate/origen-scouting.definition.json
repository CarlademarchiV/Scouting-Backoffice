{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "description": "Scouting - Origen (específico de Scouting). Único flujo que conoce la cola de Scouting: la toma con la API del backoffice (POST /api/flujo/lote, encabezado X-Scouting-Clave; sin gateway), la traduce al contrato Trabajo, llama al Planificador y registra cada resultado (PUT /api/flujo/ejecuciones/{id}/informe, POST /api/flujo/ejecuciones/{id}/resultado). Si se agotaron los intentos, pide a Comunicaciones el aviso de falla.",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "ucu_ScoutingApiUrl (ucu_ScoutingApiUrl)": {
      "defaultValue": "https://scouting.ucu.edu.uy",
      "type": "String",
      "metadata": {
        "schemaName": "ucu_ScoutingApiUrl",
        "description": "URL base del backoffice, sin barra final (en la PC: la URL del túnel)."
      }
    },
    "ucu_ScoutingApiClave (ucu_ScoutingApiClave)": {
      "defaultValue": "",
      "type": "String",
      "metadata": {
        "schemaName": "ucu_ScoutingApiClave",
        "description": "Clave de la API (scouting.api.clave). En Producción: variable de entorno de tipo Secreto (Azure Key Vault)."
      }
    }
  },
  "triggers": {
    "Recurrencia": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Minute",
        "interval": 5
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Tomar_lote": {
      "type": "Http",
      "inputs": {
        "method": "POST",
        "uri": "@{parameters('ucu_ScoutingApiUrl (ucu_ScoutingApiUrl)')}/api/flujo/lote",
        "headers": {
          "Content-Type": "application/json",
          "X-Scouting-Clave": "@parameters('ucu_ScoutingApiClave (ucu_ScoutingApiClave)')"
        },
        "body": {
          "lote": 10,
          "instancia": "@{workflow()?['run']?['name']}"
        }
      },
      "retryPolicy": {
        "type": "fixed",
        "count": 2,
        "interval": "PT30S"
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      },
      "runAfter": {},
      "description": "Toma con bloqueo de 30 min. Si se pierde la respuesta, las ejecuciones se vuelven a tomar al vencer el bloqueo."
    },
    "Hay_trabajos": {
      "type": "If",
      "expression": {
        "greater": [
          "@length(coalesce(body('Tomar_lote')?['ejecuciones'],createArray()))",
          0
        ]
      },
      "runAfter": {
        "Tomar_lote": [
          "Succeeded"
        ]
      },
      "actions": {
        "A_contrato_Trabajo": {
          "type": "Select",
          "inputs": {
            "from": "@body('Tomar_lote')?['ejecuciones']",
            "select": {
              "id": "@string(item()?['ejecucionId'])",
              "agente": "Scouting",
              "modo": "@item()?['modo']",
              "instruccion": {
                "prompt": "@item()?['prompt']",
                "plantilla": "",
                "politicas": [],
                "variables": [
                  {
                    "nombre": "titulo",
                    "valor": "@item()?['titulo']"
                  }
                ],
                "perfil": "institucional-ucu"
              },
              "resultadoPrevio": "@coalesce(item()?['informe'],'')",
              "comunicacion": {
                "canal": "correo",
                "para": [
                  "@item()?['creadorEmail']"
                ],
                "cco": "@if(equals(item()?['modo'],'prueba'),createArray(),coalesce(item()?['participantes'],createArray()))",
                "responderA": "@item()?['creadorEmail']",
                "asunto": "@concat('[Scouting',if(equals(item()?['modo'],'prueba'),' - PRUEBA',''),'] ',item()?['titulo'])",
                "plantilla": "informe",
                "banner": "@if(equals(item()?['modo'],'prueba'),'PRUEBA: este correo solo te llegó a vos.','')",
                "pie": "@coalesce(item()?['pieCorreo'],'')",
                "contenido": {
                  "titulo": "@item()?['titulo']"
                }
              },
              "metadata": {
                "ejecucionId": "@item()?['ejecucionId']",
                "exploracionId": "@item()?['exploracionId']",
                "intentos": "@item()?['intentos']",
                "creadorEmail": "@item()?['creadorEmail']",
                "titulo": "@item()?['titulo']"
              }
            }
          },
          "runAfter": {}
        },
        "Planificador": {
          "type": "Workflow",
          "inputs": {
            "host": {
              "workflowReferenceName": "<id del flujo Planificador en la solución>"
            },
            "body": {
              "text": "@{string(body('A_contrato_Trabajo'))}"
            }
          },
          "retryPolicy": {
            "type": "fixed",
            "count": 2,
            "interval": "PT30S"
          },
          "runAfter": {
            "A_contrato_Trabajo": [
              "Succeeded"
            ]
          }
        },
        "Por_cada_resultado": {
          "type": "Foreach",
          "foreach": "@json(body('Planificador')?['resultadosjson'])",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          },
          "runAfter": {
            "Planificador": [
              "Succeeded"
            ]
          },
          "actions": {
            "Hay_respuesta": {
              "type": "If",
              "description": "Guarda la respuesta del agente para no volver a consumir créditos en un reintento.",
              "expression": {
                "not": [
                  {
                    "equals": [
                      "@coalesce(items('Por_cada_resultado')?['respuesta'],'')",
                      ""
                    ]
                  }
                ]
              },
              "runAfter": {},
              "actions": {
                "Guardar_informe": {
                  "type": "Http",
                  "inputs": {
                    "method": "PUT",
                    "uri": "@{parameters('ucu_ScoutingApiUrl (ucu_ScoutingApiUrl)')}/api/flujo/ejecuciones/@{items('Por_cada_resultado')?['metadata']?['ejecucionId']}/informe",
                    "headers": {
                      "Content-Type": "application/json",
                      "X-Scouting-Clave": "@parameters('ucu_ScoutingApiClave (ucu_ScoutingApiClave)')"
                    },
                    "body": {
                      "informe": "@items('Por_cada_resultado')?['respuesta']"
                    }
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 4,
                    "interval": "PT30S"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs"
                      ]
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Registrar_resultado": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('ucu_ScoutingApiUrl (ucu_ScoutingApiUrl)')}/api/flujo/ejecuciones/@{items('Por_cada_resultado')?['metadata']?['ejecucionId']}/resultado",
                "headers": {
                  "Content-Type": "application/json",
                  "X-Scouting-Clave": "@parameters('ucu_ScoutingApiClave (ucu_ScoutingApiClave)')"
                },
                "body": {
                  "ok": "@items('Por_cada_resultado')?['ok']",
                  "destinatarios": "@items('Por_cada_resultado')?['destinatarios']",
                  "resumen": "@items('Por_cada_resultado')?['resumen']",
                  "error": "@if(items('Por_cada_resultado')?['ok'],null,concat(items('Por_cada_resultado')?['etapa'],': ',items('Por_cada_resultado')?['error']))"
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 4,
                "interval": "PT30S"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "runAfter": {
                "Hay_respuesta": [
                  "Succeeded"
                ]
              }
            },
            "Notificar": {
              "type": "If",
              "expression": {
                "equals": [
                  "@body('Registrar_resultado')?['notificar']",
                  true
                ]
              },
              "runAfter": {
                "Registrar_resultado": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Mensaje_falla": {
                  "type": "Compose",
                  "runAfter": {},
                  "inputs": {
                    "canal": "correo",
                    "plantilla": "aviso-falla",
                    "para": [
                      "@items('Por_cada_resultado')?['metadata']?['creadorEmail']"
                    ],
                    "cc": "@coalesce(body('Registrar_resultado')?['correoAlertasTi'],createArray())",
                    "asunto": "@concat('[Scouting] No se pudo generar: ',items('Por_cada_resultado')?['metadata']?['titulo'])",
                    "contenido": {
                      "titulo": "@concat('La exploración ',items('Por_cada_resultado')?['metadata']?['titulo'],' falló después de todos los reintentos.')",
                      "cuerpo": "@concat('Etapa: ',items('Por_cada_resultado')?['etapa'],decodeUriComponent('%0A'),'Error: ',items('Por_cada_resultado')?['error'],decodeUriComponent('%0A%0A'),if(equals(body('Registrar_resultado')?['desactivada'],true),'La exploración quedó desactivada por fallas seguidas. Revisala y reactivala desde el backoffice.','Se volverá a intentar en la próxima ejecución programada.'))"
                    }
                  }
                },
                "Aviso_falla": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "<id del flujo Comunicaciones en la solución>"
                    },
                    "body": {
                      "text": "@{string(outputs('Mensaje_falla'))}"
                    }
                  },
                  "retryPolicy": {
                    "type": "fixed",
                    "count": 2,
                    "interval": "PT30S"
                  },
                  "runAfter": {
                    "Mensaje_falla": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  }
}
