{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "description": "Scouting - Ejecutar exploración (flujo hijo). Genera el informe con el agente Scouting, envía el correo y registra el resultado en SQL Server.",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "ejecucion_id": {
              "type": "integer"
            },
            "modo": {
              "type": "integer",
              "description": "0 Programada, 1 Prueba, 2 Manual"
            },
            "titulo": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "informe": {
              "type": "string"
            },
            "creador_email": {
              "type": "string"
            },
            "creador_nombre": {
              "type": "string"
            },
            "participantes": {
              "type": "string",
              "description": "Correos separados por ;"
            },
            "pie_correo": {
              "type": "string"
            }
          },
          "required": [
            "ejecucion_id",
            "modo",
            "titulo",
            "prompt",
            "creador_email"
          ]
        }
      }
    }
  },
  "actions": {
    "Inicializar_informe": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "informe",
            "type": "string",
            "value": "@{coalesce(triggerBody()?['informe'], '')}"
          }
        ]
      },
      "runAfter": {}
    },
    "Try": {
      "type": "Scope",
      "runAfter": {
        "Inicializar_informe": [
          "Succeeded"
        ]
      },
      "actions": {
        "Falta_informe": {
          "type": "If",
          "description": "Si un intento anterior ya generó el informe, no se vuelve a llamar al agente (ahorra créditos).",
          "expression": {
            "equals": [
              "@variables('informe')",
              ""
            ]
          },
          "runAfter": {},
          "actions": {
            "Ejecutar_agente": {
              "type": "OpenApiConnectionWebhook",
              "description": "Copilot Studio: Ejecutar un agente y esperar (agente ucu_Scouting).",
              "inputs": {
                "host": {
                  "connectionName": "shared_microsoftcopilotstudio",
                  "operationId": "ExecuteCopilotAsyncV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio"
                },
                "parameters": {
                  "Copilot": "ucu_Scouting",
                  "body/message": "@triggerBody()?['prompt']"
                },
                "authentication": "@parameters('$authentication')"
              },
              "limit": {
                "timeout": "PT20M"
              },
              "runAfter": {}
            },
            "Guardar_informe": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sql",
                  "operationId": "ExecuteProcedure_V2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sql"
                },
                "parameters": {
                  "server": "default",
                  "database": "default",
                  "procedure": "[scouting].[sp_guardar_informe]",
                  "parameters/ejecucion_id": "@triggerBody()?['ejecucion_id']",
                  "parameters/informe": "@variables('informe')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 4,
                "interval": "PT30S"
              },
              "runAfter": {
                "Asignar_informe": [
                  "Succeeded"
                ]
              }
            },
            "Asignar_informe": {
              "type": "SetVariable",
              "inputs": {
                "name": "informe",
                "value": "@body('Ejecutar_agente')?['lastResponse']"
              },
              "runAfter": {
                "Ejecutar_agente": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Informe": {
          "type": "Compose",
          "inputs": "@variables('informe')",
          "runAfter": {
            "Falta_informe": [
              "Succeeded"
            ]
          }
        },
        "Cuerpo": {
          "type": "Compose",
          "inputs": "@trim(first(split(outputs('Informe'), '===RESUMEN===')))",
          "runAfter": {
            "Informe": [
              "Succeeded"
            ]
          }
        },
        "Resumen": {
          "type": "Compose",
          "inputs": "@if(contains(outputs('Informe'), '===RESUMEN==='), substring(trim(last(split(outputs('Informe'), '===RESUMEN==='))), 0, min(2000, length(trim(last(split(outputs('Informe'), '===RESUMEN===')))))), '')",
          "runAfter": {
            "Cuerpo": [
              "Succeeded"
            ]
          }
        },
        "Cuerpo_html": {
          "type": "Compose",
          "description": "Mismo formato que la versión Dataverse: banner PRUEBA si modo = 1, informe con saltos <br>, pie de correo.",
          "inputs": "@concat(if(equals(triggerBody()?['modo'], 1), '<div style=\"background:#fff3cd;padding:8px;border:1px solid #ffe08a\"><b>PRUEBA</b>: este correo solo te llegó a vos.</div>', ''), '<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px\">', replace(outputs('Cuerpo'), decodeUriComponent('%0A'), '<br>'), '</div><hr><p style=\"color:#666;font-size:12px\">', triggerBody()?['pie_correo'], '</p>')",
          "runAfter": {
            "Resumen": [
              "Succeeded"
            ]
          }
        },
        "Segun_modo": {
          "type": "If",
          "expression": {
            "equals": [
              "@triggerBody()?['modo']",
              1
            ]
          },
          "runAfter": {
            "Cuerpo_html": [
              "Succeeded"
            ]
          },
          "actions": {
            "Enviar_prueba": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@triggerBody()?['creador_email']",
                  "emailMessage/Subject": "[Scouting - PRUEBA] @{triggerBody()?['titulo']}",
                  "emailMessage/Body": "@outputs('Cuerpo_html')",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT1M"
              },
              "runAfter": {}
            },
            "Destinatarios_prueba": {
              "type": "Compose",
              "inputs": 1,
              "runAfter": {
                "Enviar_prueba": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Validar_participantes": {
                "type": "If",
                "expression": {
                  "equals": [
                    "@coalesce(triggerBody()?['participantes'], '')",
                    ""
                  ]
                },
                "runAfter": {},
                "actions": {
                  "Sin_participantes": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "SinParticipantes",
                        "message": "La exploración no tiene participantes activos."
                      }
                    },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {}
                }
              },
              "Enviar_a_participantes": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_office365",
                    "operationId": "SendEmailV2",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                  },
                  "parameters": {
                    "emailMessage/To": "@triggerBody()?['creador_email']",
                    "emailMessage/ReplyTo": "@triggerBody()?['creador_email']",
                    "emailMessage/Bcc": "@triggerBody()?['participantes']",
                    "emailMessage/Subject": "[Scouting] @{triggerBody()?['titulo']}",
                    "emailMessage/Body": "@outputs('Cuerpo_html')",
                    "emailMessage/Importance": "Normal"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT1M"
                },
                "runAfter": {
                  "Validar_participantes": [
                    "Succeeded"
                  ]
                }
              }
            }
          }
        },
        "Registrar_ok": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sql",
              "operationId": "ExecuteProcedure_V2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sql"
            },
            "parameters": {
              "server": "default",
              "database": "default",
              "procedure": "[scouting].[sp_registrar_resultado]",
              "parameters/ejecucion_id": "@triggerBody()?['ejecucion_id']",
              "parameters/ok": true,
              "parameters/destinatarios": "@if(equals(triggerBody()?['modo'], 1), 1, add(length(split(triggerBody()?['participantes'], ';')), 1))",
              "parameters/resumen": "@outputs('Resumen')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT30S"
          },
          "runAfter": {
            "Segun_modo": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Fallas": {
          "type": "Query",
          "inputs": {
            "from": "@result('Try')",
            "where": "@equals(item()?['status'], 'Failed')"
          },
          "runAfter": {}
        },
        "Error": {
          "type": "Compose",
          "inputs": "@substring(string(coalesce(first(body('Fallas'))?['error']?['message'], first(body('Fallas'))?['outputs']?['body'], 'Error sin detalle')), 0, min(3900, length(string(coalesce(first(body('Fallas'))?['error']?['message'], first(body('Fallas'))?['outputs']?['body'], 'Error sin detalle')))))",
          "runAfter": {
            "Fallas": [
              "Succeeded"
            ]
          }
        },
        "Registrar_error": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sql",
              "operationId": "ExecuteProcedure_V2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sql"
            },
            "parameters": {
              "server": "default",
              "database": "default",
              "procedure": "[scouting].[sp_registrar_resultado]",
              "parameters/ejecucion_id": "@triggerBody()?['ejecucion_id']",
              "parameters/ok": false,
              "parameters/error": "@outputs('Error')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT30S"
          },
          "runAfter": {
            "Error": [
              "Succeeded"
            ]
          }
        },
        "Notificar": {
          "type": "If",
          "expression": {
            "equals": [
              "@first(outputs('Registrar_error')?['body/resultsets/Table1'])?['notificar']",
              true
            ]
          },
          "runAfter": {
            "Registrar_error": [
              "Succeeded"
            ]
          },
          "actions": {
            "Avisar_falla": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@triggerBody()?['creador_email']",
                  "emailMessage/Cc": "@first(outputs('Registrar_error')?['body/resultsets/Table1'])?['correo_alertas_ti']",
                  "emailMessage/Subject": "[Scouting] No se pudo generar: @{triggerBody()?['titulo']}",
                  "emailMessage/Body": "<p>La exploración <b>@{triggerBody()?['titulo']}</b> falló después de todos los reintentos.</p><p>Error: @{outputs('Error')}</p><p>@{if(equals(first(outputs('Registrar_error')?['body/resultsets/Table1'])?['desactivada'], true), 'La exploración quedó desactivada por fallas seguidas. Revisala y reactivala desde el backoffice.', 'Se volverá a intentar en la próxima ejecución programada.')}</p>"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "Responder": {
      "type": "Response",
      "kind": "PowerApp",
      "inputs": {
        "statusCode": 200,
        "body": {
          "ok": true
        }
      },
      "runAfter": {
        "Catch": [
          "Succeeded",
          "Skipped",
          "Failed"
        ]
      }
    }
  },
  "outputs": {}
}